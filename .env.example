PORT=
MONGO_URI=
JWT_SECRET=

# Local: http://localhost:5000 | Production: https://bdoq-academy.onrender.com
API_BASE_URL=

# Local: http://localhost:5174 | Production: https://bdoq-academy-portal.vercel.app
CLIENT_URL=

# Local: http://localhost:3000 | Production: https://bdoq-public-site-a42c.vercel.app
PUBLIC_SITE_URL=

# Extra CORS origins (comma-separated)
CORS_ORIGINS=

# Local dev: allow any origin (portal on 5174, 5175, etc.). Set false before production deploy.
CORS_DISABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ↑ Get from Google Cloud Console — see docs/google-oauth-setup.md
# Redirect URI to register: {API_BASE_URL}/api/auth/google/callback

# Set false for local dev without Resend
REQUIRE_EMAIL_VERIFICATION=

# Resend (https://resend.com) — domain bdonlinequranacademy.com must be verified
RESEND_API_KEY=
FROM_EMAIL=no-reply@bdonlinequranacademy.com
# Alternative sender: support@bdonlinequranacademy.com
TEST_EMAIL_TO=

TRIAL_NOTIFY_EMAIL=bdonlinequranacademy@gmail.com
CONTACT_NOTIFY_EMAIL=bdonlinequranacademy@gmail.com
ADMISSION_NOTIFY_EMAIL=bdonlinequranacademy@gmail.com
TEACHER_APPLICATION_NOTIFY_EMAIL=bdonlinequranacademy@gmail.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# NODE_ENV=production
