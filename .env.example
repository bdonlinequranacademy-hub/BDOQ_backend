PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/myacademy
JWT_SECRET=your-jwt-secret-min-32-chars

# AI (Gemini) — required for at-risk, reports, study plan, class-log draft
GEMINI_API_KEY=

# Public API URL (no trailing slash) — used for Google OAuth callback
# Local: http://localhost:5000
# Production: https://api.albayaanacademy.com
API_BASE_URL=http://localhost:5000

# Portal URL — verification links, password reset, OAuth redirect target
CLIENT_URL=http://localhost:5174

# Marketing site URL — included in CORS allowlist when set
PUBLIC_SITE_URL=http://localhost:4321

# Extra CORS origins (comma-separated). CLIENT_URL and PUBLIC_SITE_URL are merged automatically.
# Production example:
# CORS_ORIGINS=https://portal.albayaanacademy.com,https://albayaanacademy.com
CORS_ORIGINS=

# Google OAuth — register redirect URI: {API_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth — deferred (leave empty)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Email verification (set false for local dev without SMTP)
REQUIRE_EMAIL_VERIFICATION=false

# Resend SMTP (see docs/smtp-setup.md)
SMTP_PROVIDER=resend
SMTP_USER=resend
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
TEST_EMAIL_TO=you@example.com

# Trial booking notifications (defaults to FROM_EMAIL if unset)
TRIAL_NOTIFY_EMAIL=hello@albayaanacademy.com

# Contact form notifications (defaults to TRIAL_NOTIFY_EMAIL if unset)
CONTACT_NOTIFY_EMAIL=

# NODE_ENV=production
