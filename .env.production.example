# Copy these into Render → Environment (secrets only in dashboard — never commit .env)
# Local dev: use .env with localhost URLs

NODE_ENV=production

API_BASE_URL=https://bdoq-academy.onrender.com
CLIENT_URL=https://myacademy.bdonlinequranacademy.com
PUBLIC_SITE_URL=https://bdonlinequranacademy.com
CORS_DISABLED=false

# Optional: extra origins (comma-separated) if you use www or alternate portal host
# CORS_ORIGINS=https://www.bdonlinequranacademy.com,https://admin.bdonlinequranacademy.com

# Vercel preview URLs are allowed when CLIENT_URL / PUBLIC_SITE_URL match production Vercel projects.

# Required secrets (Render dashboard):
# MONGO_URI=
# JWT_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Resend — system emails (verified domain sender, NOT Gmail):
# RESEND_API_KEY=re_...
# FROM_EMAIL=no-reply@bdonlinequranacademy.com

# Admin inbox — form notifications (marketing Gmail):
# TRIAL_NOTIFY_EMAIL=bdonlinequranacademy@gmail.com
# CONTACT_NOTIFY_EMAIL=bdonlinequranacademy@gmail.com
# ADMISSION_NOTIFY_EMAIL=bdonlinequranacademy@gmail.com
# TEACHER_APPLICATION_NOTIFY_EMAIL=bdonlinequranacademy@gmail.com

# REQUIRE_EMAIL_VERIFICATION=true

# On-demand cache revalidation (public-site Next.js webhook)
# Must match REVALIDATE_SECRET in Vercel env vars for the public site
# REVALIDATE_SECRET=your-long-random-secret-here
