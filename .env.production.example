# Copy these URL values into Render → Environment (secrets stay in dashboard only)
# Local dev: use .env with localhost URLs

NODE_ENV=production

API_BASE_URL=https://bdoq-academy.onrender.com
CLIENT_URL=https://bdoq-academy-portal.vercel.app
PUBLIC_SITE_URL=https://bdoq-public-site-a42c.vercel.app
CORS_DISABLED=false

# Optional: extra origins (comma-separated), e.g. a custom domain
# CORS_ORIGINS=https://portal.bdonlinequranacademy.com

# Vercel preview URLs (bdoq-academy-portal-*.vercel.app) are allowed automatically
# when CLIENT_URL is your production Vercel portal URL — no need to list each preview.

# Still required on Render (set in dashboard — do not commit real values):
# MONGO_URI=
# JWT_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# RESEND_API_KEY=re_...
# FROM_EMAIL=no-reply@bdonlinequranacademy.com
# CLIENT_URL=https://admin.bdonlinequranacademy.com
# PUBLIC_SITE_URL=https://www.bdonlinequranacademy.com
